<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 
        Nivel de reglas CAxxxx de los analyzers de .NET (Microsoft.CodeAnalysis.NetAnalyzers).
        • None:         Ningún CA habilitado salvo que lo actives a mano.
        • Default:      El subconjunto "de fábrica" del SDK — bastante conservador, muchas reglas quedan apagadas
        • Minimum:      Solo lo más básico/seguro.
        • Recommended:  Set más amplio, "buenas prácticas" recomendadas por Microsoft.
        • All:          Todas las CAxxxx habilitadas, incluidas las más opinables/ruidosas.
        -->
        <AnalysisMode>All</AnalysisMode>
        <!--
        Ejecuta las reglas de code style (IDExxxx: csharp_style_*, dotnet_style_*, naming, formato) también en el build.
        Por defecto el SDK las ejecuta solo en el editor de VS: sin esto, dotnet build (y el CI) no las ve y el Error List
        de VS muestra warnings que el build no reporta.
        -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <!--
        En el CI cualquier warning rompe el build; en local (VS o dotnet build) se permiten mientras se desarrolla.
        • CI:                         lo setean GitHub Actions y GitLab CI (variable de entorno, MSBuild la expone como propiedad).
        • TF_BUILD:                   lo setea Azure DevOps.
        • ContinuousIntegrationBuild: para pipelines que lo pasan explícito (-p:ContinuousIntegrationBuild=true).
        Para reproducir el CI en local: dotnet build Records.slnx -p:CI=true
        -->
        <TreatWarningsAsErrors Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    </PropertyGroup>
    
    <ItemGroup>
        <!-- Agrega el paquete StyleCop.Analyzers a todos los proyectos. -->
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <!-- Integra el archivo stylecop.json a todos los proyectos. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    </ItemGroup>

    <ItemGroup>
        <!--
        Cada proyecto expone sus tipos internal a su proyecto de unit tests (<Proyecto>.UnitTests), por convención de
        nombre: los handlers, validators y endpoints son internal sealed y los tests los crean directamente. Si el
        proyecto de tests no existe, el atributo no tiene efecto.
        -->
        <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
    </ItemGroup>

</Project>