root = true

[*.cs]

# --- Formato básico ---
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
#max_line_length = 120

# --- Enciende todo en warning ---
# StyleCop (SA) + IDE (code-style) + CA (calidad) a warning por defecto
dotnet_analyzer_diagnostic.category-StyleCop.severity = warning
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-CodeQuality.severity = warning

# NOTA: como las 3 líneas de arriba fuerzan "warning" por categoría, el ":silent"/":suggestion"
# que Visual Studio pone por defecto al lado de cada regla de abajo queda pisado (ver orden de
# precedencia: dotnet_diagnostic.<ID> > category-XXX.severity > severidad propia de la opción).
# Se dejan igual esos sufijos como referencia de cuál es el default "de fábrica" de cada regla,
# y para poder aflojar puntualmente alguna con dotnet_diagnostic.IDExxxx.severity si hiciera falta.

#### .NET Coding Conventions ####

# Organize usings
dotnet_sort_system_directives_first = true                                    # System.* primero (IDE0065 orden)
dotnet_separate_import_directive_groups = false                               # no separar grupos de usings con línea en blanco

# this./Me. preferences (IDE0003/IDE0009)
dotnet_style_qualification_for_field = false:silent                           # no anteponer "this." a campos
dotnet_style_qualification_for_property = false:silent                        # no anteponer "this." a propiedades
dotnet_style_qualification_for_method = false:silent                          # no anteponer "this." a métodos
dotnet_style_qualification_for_event = false:silent                           # no anteponer "this." a eventos

# Language keywords vs BCL types preferences (IDE0049)
dotnet_style_predefined_type_for_locals_parameters_members = true:silent      # preferir "int" sobre "Int32" en variables/params/miembros
dotnet_style_predefined_type_for_member_access = true:silent                  # preferir "int.MaxValue" sobre "Int32.MaxValue"

# Parentheses preferences (IDE0047/IDE0048)
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent

# Modifier preferences (IDE0040/IDE0044)
dotnet_style_require_accessibility_modifiers = for_non_interface_members:silent  # exigir "public/private/..." explícito salvo en interfaces
dotnet_style_readonly_field = true:suggestion                                    # marcar "readonly" los campos que nunca se reasignan fuera del ctor

# Expression-level preferences (IDE0017/IDE0028/IDE0032/IDE0033/IDE0037/IDE0041/IDE0042/IDE0075...)
dotnet_style_object_initializer = true:suggestion                             # usar inicializador de objeto en vez de asignaciones sueltas
dotnet_style_collection_initializer = true:suggestion                        # usar inicializador de colección
dotnet_style_explicit_tuple_names = true:suggestion                          # usar nombres de tupla en vez de Item1/Item2
dotnet_style_null_propagation = true:suggestion                              # usar "?." en vez de chequeo manual de null
dotnet_style_coalesce_expression = true:suggestion                           # usar "??" en vez de condicional ternario para null
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion  # "is null" en vez de ReferenceEquals(x, null)
dotnet_style_prefer_inferred_tuple_names = true:suggestion                   # no repetir el nombre si se puede inferir en la tupla
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion   # ídem para tipos anónimos
dotnet_style_prefer_auto_properties = true:silent                           # preferir auto-propiedad sobre propiedad con campo de respaldo manual
dotnet_style_prefer_conditional_expression_over_assignment = true:silent    # usar "x = cond ? a : b" en vez de if/else con asignación
dotnet_style_prefer_conditional_expression_over_return = true:silent        # usar "return cond ? a : b" en vez de if/else con return
dotnet_style_prefer_compound_assignment = true:suggestion                   # usar "x += 1" en vez de "x = x + 1"
dotnet_style_prefer_simplified_interpolation = true:suggestion              # simplificar interpolación de strings redundante
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion        # simplificar expresiones booleanas redundantes

# Parameter preferences (IDE0060)
dotnet_code_quality_unused_parameters = all:suggestion                      # avisar sobre parámetros no usados (métodos públicos y privados)

# New line preferences
dotnet_style_allow_multiple_blank_lines_experimental = true:silent          # permitir más de una línea en blanco seguida
dotnet_style_allow_statement_immediately_after_block_experimental = true:silent  # permitir sentencia pegada justo después de un bloque "{ }"

#### C# Coding Conventions ####

# var preferences (IDE0007/IDE0008)
csharp_style_var_for_built_in_types = true:silent                # "var" para tipos primitivos (int, string, etc.) cuando el tipo es obvio
csharp_style_var_when_type_is_apparent = true:silent              # "var" cuando el tipo ya es evidente por la derecha (ej. "new Foo()")
csharp_style_var_elsewhere = true:silent                          # "var" en el resto de los casos

# Expression-bodied members (IDE0021/IDE0022/IDE0023/IDE0024/IDE0025/IDE0026/IDE0027/IDE0053...)
csharp_style_expression_bodied_methods = false:silent              # métodos: preferir cuerpo con "{ }" en vez de "=>"
csharp_style_expression_bodied_constructors = false:silent         # constructores: ídem
csharp_style_expression_bodied_operators = false:silent            # operadores: ídem
csharp_style_expression_bodied_properties = true:silent            # propiedades: preferir "=>" cuando es una sola expresión
csharp_style_expression_bodied_indexers = true:silent              # indexadores: ídem
csharp_style_expression_bodied_accessors = true:silent             # get/set: ídem
csharp_style_expression_bodied_lambdas = true:silent               # lambdas: preferir "=>" de una línea
csharp_style_expression_bodied_local_functions = false:silent      # funciones locales: preferir cuerpo con "{ }"

# Pattern matching preferences (IDE0019/IDE0020/IDE0066/IDE0078/IDE0083)
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion   # "if (x is Foo f)" en vez de "is" + cast manual
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion   # ídem con "as" + chequeo de null
csharp_style_prefer_switch_expression = true:suggestion                  # usar "switch" expression cuando reemplaza un switch clásico simple
csharp_style_prefer_pattern_matching = true:silent                       # preferir pattern matching en general
csharp_style_prefer_not_pattern = true:suggestion                        # usar "is not Foo" en vez de "!(x is Foo)"

# Null-checking preferences (IDE0016/IDE0031)
csharp_style_throw_expression = true:suggestion            # "x ?? throw new ArgumentNullException()" en vez de if + throw
csharp_style_conditional_delegate_call = true:suggestion   # "delegate?.Invoke()" en vez de chequeo manual de null antes de invocar

# Modifier preferences (IDE0036/IDE0062)
csharp_prefer_static_local_function = true:suggestion      # marcar "static" las funciones locales que no capturan estado
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:silent  # orden de modificadores

# Code-block preferences (IDE0011/IDE0063/IDE0160/IDE0161)
csharp_prefer_braces = true:silent                                # usar siempre "{ }" en if/for/while, aunque sea una sola línea
csharp_prefer_simple_using_statement = true:suggestion             # preferir "using var x = ..." sin llaves cuando aplica
csharp_style_namespace_declarations = file_scoped:suggestion       # preferir namespace de una línea ("namespace Foo;") sobre el de bloque

# Expression-level preferences (IDE0018/IDE0034/IDE0039/IDE0042/IDE0057/IDE0056/IDE0090)
csharp_style_inlined_variable_declaration = true:suggestion               # declarar "out var x" en el lugar del uso
csharp_prefer_simple_default_expression = true:suggestion                 # "default" en vez de "default(Foo)" cuando el tipo es inferible
csharp_style_pattern_local_over_anonymous_function = true:suggestion      # función local con nombre en vez de función anónima asignada a variable
csharp_style_deconstructed_variable_declaration = true:suggestion         # deconstruir tuplas en la declaración
csharp_style_prefer_index_operator = true:suggestion                      # usar el operador índice "^1" en vez de "Length - 1"
csharp_style_prefer_range_operator = true:suggestion                      # usar el operador rango "a..b" en vez de Substring/Slice manual
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion  # "Foo x = new();" en vez de "Foo x = new Foo();"

# 'using' directive preferences (IDE0065)
# Ligado a stylecop.json > orderingRules.usingDirectivesPlacement = "outsideNamespace" (ver sección StyleCop más abajo):
# si estos dos quedan desalineados, el IDE sugiere una ubicación y SA1200 marca warning por la otra.
csharp_using_directive_placement = outside_namespace:suggestion

# New line preferences
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = true:silent  # permitir línea en blanco entre "}" seguidas
csharp_style_allow_embedded_statements_on_same_line_experimental = true:silent        # permitir "if (x) return;" en una sola línea

#### C# Formatting Rules ####

# New line rules
csharp_new_line_before_open_brace = all                       # "{" siempre en línea propia (Allman style)
csharp_new_line_before_else = true                             # "else" en línea propia
csharp_new_line_before_catch = true                            # "catch" en línea propia
csharp_new_line_before_finally = true                          # "finally" en línea propia
csharp_new_line_before_members_in_object_initializers = true   # cada miembro de un inicializador de objeto en su propia línea
csharp_new_line_before_members_in_anonymous_types = true       # ídem para tipos anónimos
csharp_new_line_between_query_expression_clauses = true        # cada cláusula LINQ (from/where/select) en su propia línea

# Indentation rules
csharp_indent_case_contents = true             # indentar el contenido de cada "case" dentro del switch
csharp_indent_switch_labels = true             # indentar las etiquetas "case"/"default" respecto del "switch"
csharp_indent_labels = flush_left              # las etiquetas (goto) van pegadas al margen izquierdo
csharp_indent_block_contents = true            # indentar el contenido de un bloque "{ }"
csharp_indent_braces = false                   # no indentar las llaves en sí
csharp_indent_case_contents_when_block = false # no doble-indentar cuando el "case" ya usa "{ }"

# Space rules
csharp_space_after_cast = false                                    # sin espacio después de un cast: "(Foo)x"
csharp_space_after_keywords_in_control_flow_statements = true       # espacio entre "if"/"for"/"while" y el paréntesis
csharp_space_between_parentheses = false                           # sin espacio pegado dentro de los paréntesis
csharp_space_before_colon_in_inheritance_clause = true              # espacio antes de ":" en "class Foo : IBar"
csharp_space_after_colon_in_inheritance_clause = true               # espacio después de ese ":"
csharp_space_around_binary_operators = before_and_after             # espacio a ambos lados de "+", "=", "==", etc.
csharp_space_between_method_declaration_parameter_list_parentheses = false  # sin espacio pegado en "Foo(int x)"
csharp_space_between_method_call_parameter_list_parentheses = false        # sin espacio pegado al llamar "Foo(x)"

# Wrap rules
csharp_preserve_single_line_statements = true   # no forzar salto de línea si la sentencia ya está en una sola línea
csharp_preserve_single_line_blocks = true        # ídem para bloques cortos "{ }"

#### Naming Styles ####

# Naming rules
dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
# Interfaces con prefijo "I" (IFoo)                                          # IDE1006

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
# Clases/structs/interfaces/enums en PascalCase                              # IDE1006

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case
# Propiedades/eventos/métodos en PascalCase                                  # IDE1006

dotnet_naming_rule.private_or_internal_field_should_be_begins_with_underscore.severity = suggestion
dotnet_naming_rule.private_or_internal_field_should_be_begins_with_underscore.symbols = private_or_internal_field
dotnet_naming_rule.private_or_internal_field_should_be_begins_with_underscore.style = begins_with_underscore
# Campos private/internal en camelCase con prefijo "_" (_miCampo)             # IDE1006, coherente con SA1309 = none (ver abajo)

# Symbol specifications
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.interface.required_modifiers =

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.types.required_modifiers =

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.non_field_members.required_modifiers =

dotnet_naming_symbols.private_or_internal_field.applicable_kinds = field
dotnet_naming_symbols.private_or_internal_field.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_or_internal_field.required_modifiers =

# Naming styles
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.begins_with_underscore.required_prefix = _
dotnet_naming_style.begins_with_underscore.capitalization = camel_case


#### Stylecop.Analyzer (SAxxxx rules) ####

# SA1609: Property documentation should have value
dotnet_diagnostic.SA1609.severity = none

# SA1610: Property documentation should have value text
dotnet_diagnostic.SA1610.severity = none

# SA1623: Property summary documentation should match accessors
dotnet_diagnostic.SA1623.severity = none

# SA1642: Constructor summary documentation should begin with standard text
dotnet_diagnostic.SA1642.severity = none

# SA1650:
dotnet_diagnostic.SA1650.severity = none

# SA1633: File should have header
dotnet_diagnostic.SA1633.severity = none

# SA1124: Do not use regions.
# Why not! I love regions!!!
dotnet_diagnostic.SA1124.severity = none

# SA1309: Field names should not begin with underscore
dotnet_diagnostic.SA1309.severity = none

# SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none

# SA1512: Single-line comments should not be followed by blank line
dotnet_diagnostic.SA1512.severity = suggestion

# SA1208: SystemUsingDirectivesMustBePlacedBeforeOtherUsingDirectives
dotnet_diagnostic.SA1208.severity = suggestion

# SA1401: Field should be private.
# NOTE: Suppress this rule in files only that be base clases like Repository with the next justification:
# "I prefer to use it as field just in protected fields in base classes like Repository base class."
#dotnet_diagnostic.SA1401.severity = suggestion

# CAxxxx.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1822.severity = none # El miembro "GetValidationErrors" no tiene acceso a los datos de la instancia y se puede marcar como static.

#### Rider/Resharper ####

# ReSharper/Rider: preferencia de coma final en listas/inicializadores multilínea.
resharper_csharp_trailing_comma_in_multiline_lists = true   # true = permitir/preferir coma final, false = quitarla.


